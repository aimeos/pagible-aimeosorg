{
	"name": "aimeos-extensions/<extname>",
	"description": "Aimeos <extname> extension",
	"keywords": ["aimeos", "extension"],
	"type": "typo3-cms-extension",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"require": {
		"php": "^8.1",
		"typo3/cms-core": "^12.4||^13.4",
		"aimeos/aimeos-core": "^2025.04"
	},
	"autoload": {
		"classmap": ["Classes"],
		"psr-4": {
			"Aimeos\\Aimeos\\": "Classes"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "<extname>"
		}
	}
}
