{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aimeos/pagible-aimeosorg",
    "description": "Aimeos.org theme, extension builder and TYPO3 importer for Pagible CMS",
    "keywords": ["laravel", "cms", "theme", "aimeos", "ecommerce", "extension-builder", "typo3", "import"],
    "homepage": "https://aimeos.org",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "aimeos/pagible-core": "dev-master",
        "aimeos/pagible-theme": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\AimeosServiceProvider"
            ]
        }
    }
}
